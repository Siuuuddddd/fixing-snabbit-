# Copy to .env only if you prefer to provide your own local values.
# The repository script scripts/init-local-env.ps1 generates strong random values instead.

SPRING_PROFILES_ACTIVE=local

USER_DB_USERNAME=snabbit
USER_DB_PASSWORD=
BOOKING_DB_USERNAME=snabbit
BOOKING_DB_PASSWORD=
WORKER_DB_USERNAME=snabbit
WORKER_DB_PASSWORD=
WALLET_DB_USERNAME=snabbit
WALLET_DB_PASSWORD=
SUPPORT_DB_USERNAME=snabbit
SUPPORT_DB_PASSWORD=
NOTIFICATION_DB_USERNAME=snabbit
NOTIFICATION_DB_PASSWORD=

JWT_SECRET=
OTP_PEPPER=
SERVICE_AUTH_TOKEN=

OTP_PROVIDER=twilio-verify
OTP_EXPOSE_CODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=

PUSH_PROVIDER=logging
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_HOST_FILE=
FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
FCM_BASE_URL=https://fcm.googleapis.com

RAZORPAY_MODE=fake
